{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": ["Bash(curl *)", "Bash(wget *)", "Bash(git push *)", "Bash(git push)"],
    "deny": ["Bash(rm -rf *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node scripts/hooks/run-related-tests.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
