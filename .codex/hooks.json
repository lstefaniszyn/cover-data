{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint .",
            "timeout": 10,
            "statusMessage": "Running ESLint lint"
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "timeout": 30,
            "statusMessage": "Running TypeScript check"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/run-related-tests.mjs",
            "timeout": 30,
            "statusMessage": "Running related tests for edited file"
          }
        ]
      }
    ]
  }
}
